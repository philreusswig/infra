[include]
    path = ~/.gitconfig.user

[core]
    editor = nvim
    autocrlf = input

[diff]
    tool = vscode

[difftool "vscode"]
    cmd = code --wait --diff "$LOCAL" "$REMOTE"
    keepBackup = false

[difftool]
    prompt = false

[merge]
    tool = vscode

[mergetool "vscode"]
    cmd = code --wait "$MERGED"
    keepBackup = false
    trustExitCode = true

[mergetool]
    prompt = false
